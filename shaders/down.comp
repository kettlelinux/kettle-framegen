// Next luma pyramid level: 2x2 average of the level above (one bilinear tap between them).
#version 450
layout(local_size_x = 8, local_size_y = 8) in;

layout(binding = 0) uniform sampler2D pyramid;  // all levels
layout(binding = 1, rgba8) uniform writeonly image2D dst;

layout(push_constant) uniform PC {
    int src_level;
} pc;

void main()
{
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(dst);
    if (any(greaterThanEqual(p, size)))
        return;
    vec2 uv = (vec2(p) + 0.5) / vec2(size);
    imageStore(dst, p, vec4(textureLod(pyramid, uv, float(pc.src_level)).r));
}
