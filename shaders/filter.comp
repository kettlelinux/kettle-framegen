// Final vector field: 3x3 vector median of level 0 (the vector closest to all its neighbours),
// which drops lone wrong matches without blurring motion edges.
#version 450
layout(local_size_x = 8, local_size_y = 8) in;

layout(binding = 0) uniform sampler2D src;
layout(binding = 1, rgba16f) uniform writeonly image2D dst;

void main()
{
    ivec2 b = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(dst);
    if (any(greaterThanEqual(b, size)))
        return;
    vec4 v[9];
    for (int i = 0; i < 9; i++)
        v[i] = texelFetch(src, clamp(b + ivec2(i % 3 - 1, i / 3 - 1), ivec2(0), size - 1), 0);
    int best = 4;
    float best_d = 1e30;
    for (int i = 0; i < 9; i++) {
        float d = 0.0;
        for (int j = 0; j < 9; j++) {
            vec2 e = abs(v[i].xy - v[j].xy);
            d += e.x + e.y;
        }
        if (d < best_d) {
            best_d = d;
            best = i;
        }
    }
    imageStore(dst, b, v[best]);
}
